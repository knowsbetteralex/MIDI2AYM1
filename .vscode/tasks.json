{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MIDI2AYM1: Run",
      "detail": "Open the desktop converter using the project virtual environment.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["-m", "midi2aym1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "MIDI2AYM1: Build EXE",
      "detail": "Build a standalone Windows GUI executable at dist/MIDI2AYM1.exe.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m", "PyInstaller",
        "--noconfirm",
        "--onefile",
        "--windowed",
        "--noupx",
        "--name", "MIDI2AYM1",
        "--paths", "${workspaceFolder}",
        "--hidden-import", "pygame.mixer",
        "--specpath", "${workspaceFolder}/build",
        "--workpath", "${workspaceFolder}/build/pyinstaller",
        "--distpath", "${workspaceFolder}/dist",
        "${workspaceFolder}/run_app.py"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "MIDI2AYM1: Install EXE build dependencies",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "MIDI2AYM1: Install EXE build dependencies",
      "detail": "Install the runtime and PyInstaller in the project virtual environment.",
      "hide": true,
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements-build.txt"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MIDI2AYM1: Setup",
      "detail": "Create .venv and install requirements. Run once before the first launch.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "MIDI2AYM1: Create venv",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MIDI2AYM1: Create venv",
      "hide": true,
      "type": "process",
      "command": "python3",
      "windows": { "command": "py", "args": ["-3", "-m", "venv", ".venv"] },
      "args": ["-m", "venv", ".venv"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "MIDI2AYM1: Test",
      "detail": "Run the converter, codec, CLI and WAV regression tests.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
